API_TOKEN=ganti-token-rahasia-ini

# jev | sumopod | hybrid
CLASSIFIER_MODE=hybrid
JEV_MIN_CONFIDENCE=0.5

TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

SUMOPOD_API_KEY=
SUMOPOD_MODEL=gpt-4o-mini

# Vector memory (ChromaDB) untuk few-shot / tuning
VECTOR_STORE_ENABLED=true
DATA_DIR=data
VECTOR_TOP_K=3
VECTOR_MIN_SIMILARITY=0.72
# fallback (default, tanpa torch) | auto | clip
EMBEDDING_BACKEND=fallback
CLIP_MODEL=clip-ViT-B-32

